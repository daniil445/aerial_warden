/* AerialWarden palette. Geometry and video overlays are managed separately. */
QWidget { color: #E6EDF3; }
QMainWindow, QDialog, QWidget#centralwidget { background-color: #0D1117; }
QGroupBox {
    background-color: #161B22;
    border: 1px solid #30363D;
    border-radius: 5px;
    margin-top: 9px;
    padding-top: 8px;
}
QGroupBox::title { subcontrol-origin: margin; left: 9px; padding: 0 4px; color: #8B949E; }
QPushButton, QToolButton {
    background-color: #1C222B;
    border: 1px solid #30363D;
    border-radius: 4px;
    padding: 4px 7px;
}
QPushButton:hover, QToolButton:hover { background-color: #161B22; border-color: #409EFF; }
QPushButton:checked, QToolButton:checked { background-color: #2F81F7; border-color: #58A6FF; }
QPushButton:pressed, QToolButton:pressed { background-color: #58A6FF; color: #0D1117; }
QPushButton:focus, QToolButton:focus { border-color: #58A6FF; }
QPushButton#self_record:checked, QPushButton#stream_record:checked {
    background-color: #1C222B; border-color: #F85149; color: #E6EDF3;
}
QPushButton:disabled, QToolButton:disabled { background-color: #161B22; color: #8B949E; border-color: #30363D; }
/* Auxiliary buttons beside the direction pad. */
QPushButton#pb_home {
    background-color: #000000;
    border: 1.5px solid #2F81F7;
}
QPushButton#pb_home:hover { border-color: #58A6FF; }
QPushButton#pb_home:pressed { background-color: #102A43; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #0D1117;
    border: 1px solid #30363D;
    border-radius: 3px;
    padding: 3px;
    selection-background-color: #2F81F7;
    selection-color: #E6EDF3;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-color: #58A6FF; }
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled { color: #8B949E; background-color: #161B22; }
QComboBox QAbstractItemView { background: #161B22; selection-background-color: #2F81F7; }
QAbstractItemView {
    background-color: #161B22;
    alternate-background-color: #1C222B;
    border: 1px solid #30363D;
    gridline-color: #30363D;
    selection-background-color: #2F81F7;
    selection-color: #E6EDF3;
}
QAbstractItemView::item:selected { background-color: #2F81F7; color: #E6EDF3; }
QHeaderView::section { background-color: #1C222B; color: #8B949E; border: 1px solid #30363D; padding: 4px; }
QTableCornerButton::section { background: #1C222B; border: 1px solid #30363D; }
QTabWidget::pane { border: 1px solid #30363D; background: #161B22; }
QTabBar::tab { background: #1C222B; color: #8B949E; border: 1px solid #30363D; padding: 5px 8px; }
QTabBar::tab:selected { color: #E6EDF3; background: #161B22; border-bottom: 2px solid #58A6FF; }
QTabBar::tab:hover { color: #409EFF; }
QSlider::groove:horizontal { height: 5px; background: #30363D; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #2F81F7; border-radius: 2px; }
QSlider::handle:horizontal { background: #58A6FF; border: 1px solid #2F81F7; width: 12px; margin: -5px 0; border-radius: 4px; }
QSlider::handle:horizontal:hover { background: #409EFF; }
QSlider::groove:vertical { width: 5px; background: #30363D; border-radius: 2px; }
QSlider::handle:vertical { background: #58A6FF; height: 12px; margin: 0 -5px; border-radius: 4px; }
QSlider::handle:disabled { background: #8B949E; border-color: #30363D; }
QCheckBox, QRadioButton { spacing: 5px; }
QCheckBox::indicator { width: 13px; height: 13px; border: 1px solid #30363D; border-radius: 3px; background: #0D1117; }
QCheckBox::indicator:checked { background: #2F81F7; border-color: #58A6FF; }
QCheckBox::indicator:hover { border-color: #409EFF; }
QCheckBox:disabled, QRadioButton:disabled, QLabel:disabled { color: #8B949E; }
QMenuBar, QMenu, QStatusBar { background-color: #161B22; color: #E6EDF3; }
QMenu { border: 1px solid #30363D; }
QMenu::item { padding: 5px 20px; }
QMenu::item:selected, QMenuBar::item:selected { background: #2F81F7; }
QMenu::separator { height: 1px; background: #30363D; margin: 4px; }
QToolTip { background: #1C222B; color: #E6EDF3; border: 1px solid #30363D; padding: 4px; }
QScrollBar:vertical { background: #161B22; width: 12px; }
QScrollBar:horizontal { background: #161B22; height: 12px; }
QScrollBar::handle { background: #30363D; border-radius: 4px; min-width: 12px; min-height: 12px; }
QScrollBar::handle:hover { background: #8B949E; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QWidget[status="normal"] { color: #3FB950; }
QWidget[status="warning"] { color: #D29922; }
QWidget[status="error"] { color: #F85149; }
